# Package des Lernpartners liegt auf GitHub Packages, nicht auf npmjs.com.
# Alle Packages mit Scope @samusn werden von der GitHub-Registry geladen.
@samusn:registry=https://npm.pkg.github.com

# Auch zum Lesen braucht GitHub Packages ein Token (read:packages).
# Das Token steht NICHT hier, sondern in der Umgebungsvariable GITHUB_TOKEN.
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
